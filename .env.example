# UF Research Metrics Platform - Environment Variables
# Copy this file to .env and update values for your environment

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL connection string for the API service
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
# For local development: postgresql://postgres:postgres@localhost:5432/uf_research_metrics?schema=public
# For Docker: Use the connection string from docker-compose.yml (auto-configured)
DATABASE_URL="postgresql://user:password@localhost:5432/uf_research_metrics?schema=public"

# ============================================================================
# API Service Configuration
# ============================================================================
# Port on which the API server will listen
# Default: 3001
API_PORT=3001

# Node.js environment (development, production, test)
# Controls logging, error details, and some behavior
# Default: development
NODE_ENV=development

# Comma-separated list of origins allowed to call the API (CORS).
# Default covers local dev (Vite on 3000, Docker Compose web on 3030).
# For production: set to the deployed web origin(s), e.g. https://research-metrics.ufl.edu
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3030

# ============================================================================
# Web Application Configuration
# ============================================================================
# Base URL of the API server (used by frontend to make requests)
# For local development: http://localhost:3001
# For Docker: http://localhost:3001 (browser connects to host)
# For production: Update to your production API URL
VITE_API_URL=http://localhost:3001

# ============================================================================
# Docker Compose Overrides (optional)
# ============================================================================
# These are used by docker-compose.yml if you need to override defaults
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=uf_research_metrics
# POSTGRES_PORT=5432
# WEB_PORT=3000

# ============================================================================
# Redis Cache Configuration
# ============================================================================
# Redis connection URL for API response caching (metrics/insights endpoints)
# For local development: redis://localhost:6379
# For Docker: redis://redis:6379 (auto-configured via docker-compose)
# Cache is best-effort — API continues serving if Redis is unavailable
REDIS_URL=redis://localhost:6379

# ============================================================================
# Authentication
# ============================================================================
# Secret key for signing JWT tokens — use a long random string in production
JWT_SECRET=replace-with-a-long-random-secret

# Default admin user created by db:seed
ADMIN_EMAIL=admin@ufl.edu
ADMIN_PASSWORD=changeme

# ============================================================================
# Logging
# ============================================================================
# Log level for pino structured logger (JSON in production, pretty in development)
LOG_LEVEL=info  # trace|debug|info|warn|error

# ============================================================================
# Compliance / Governance (B13)
# ============================================================================
# Audit-log retention: the ingest-worker runs a daily BullMQ job that hard-deletes
# audit_logs older than AUDIT_LOG_RETENTION_DAYS. Floored at 2 days in code so it
# can never delete rows inside the daily-active-users 24h window. See docs/GOVERNANCE.md.
# AUDIT_LOG_RETENTION_DAYS=365
# AUDIT_LOG_PRUNE_CRON=0 2 * * *          # daily 02:00 (offset from the 07:00 expiry scan)
# AUDIT_LOG_PRUNE_TZ=America/New_York

# ============================================================================
# OpenTelemetry Tracing (optional)
# ============================================================================
# Distributed tracing across api -> Kafka -> ingest-worker, exported via OTLP.
# Opt-in: tracing is a no-op unless OTEL_TRACES_ENABLED=true. Requires a
# collector (Jaeger all-in-one is provided in docker-compose; UI on :16686).
# OTEL_TRACES_ENABLED=true
# For host-based runs: http://localhost:4318  | For Docker: http://jaeger:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ============================================================================
# RAG / pgvector (optional)
# ============================================================================
# Voyage AI key for grant embeddings (voyage-3, 1024-dim). Without it, embedding
# and the /ask endpoint are disabled (the worker skips embed-on-ingest; /ask -> 503).
# VOYAGE_API_KEY=
# Embed new grants in the worker on ingest (set false for bulk loads; use `pnpm embed:grants`).
# EMBED_ON_INGEST=true
# Anthropic key + model for the /ask RAG endpoint (streamed answers with grant citations).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ============================================================================
# Grafana (optional, Docker only)
# ============================================================================
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=admin

# ============================================================================
# Testing (optional)
# ============================================================================
# Separate database URL for running tests (prevents test data pollution)
# If not set, tests will use DATABASE_URL
# TEST_DATABASE_URL="postgresql://user:password@localhost:5432/uf_research_metrics_test?schema=public"
