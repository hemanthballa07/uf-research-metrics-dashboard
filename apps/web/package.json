    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@uf-research-metrics-platform/sdk": "workspace:*",
    "@uf-research-metrics-platform/shared": "workspace:*",
    "framer-motion": "^12.23.26",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.1",
