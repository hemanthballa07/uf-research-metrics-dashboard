{
  "name": "@uf-research-metrics-platform/sdk",
  "version": "0.1.0",
  "description": "Generated TypeScript SDK for the UF Research Metrics API — types derived from the OpenAPI spec.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "generate": "openapi-typescript ../shared/dist/openapi.json -o ./src/schema.d.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.4"
  },
  "devDependencies": {
    "openapi-typescript": "^7.5.0",
    "typescript": "^5.3.3"
  }
}
